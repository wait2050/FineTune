<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSUIElement</key>
	<true/>
	<key>NSAudioCaptureUsageDescription</key>
	<string>FineTune needs access to control volume levels for individual applications.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FineTune uses the microphone to measure output timing during automatic delay calibration and to capture audio from input-capable devices.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>FineTune uses Bluetooth to connect paired audio devices from the menu bar.</string>
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/ronitsingh10/FineTune/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>xExSoQmCLDCez0KyhZ9EM9PdOZFZgyX/+VF+OVrpIlo=</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(FINETUNE_URL_SCHEME)</string>
			</array>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		</dict>
	</array>
</dict>
</plist>
