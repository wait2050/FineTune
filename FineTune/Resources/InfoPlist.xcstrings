{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune needs access to control volume levels for individual applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 需要录制系统音频的权限，以调节各应用音量并向多个设备同步播放声音。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune uses the microphone to measure output timing during automatic delay calibration and to capture audio from input-capable devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 在自动延迟校准时使用麦克风测量各输出的发声时间，也可能用于读取具备输入功能的音频设备。校准录音只在本机内存中分析，不会上传或保存。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune uses Bluetooth to connect paired audio devices from the menu bar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "FineTune 使用蓝牙从菜单栏连接已配对的音频设备。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
